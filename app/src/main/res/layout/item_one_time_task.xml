<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AscendU.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/stitch_card_padding">

        <!-- Checkbox with subtle haptic feel -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_task_complete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonTint="@color/stitch_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/stitch_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Submit MCA Architecture Design Document" />

            <TextView
                android:id="@+id/tv_task_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/stitch_text_secondary"
                android:textSize="@dimen/text_body_secondary"
                tools:text="Today • 16:00 - 17:30" />

            <!-- Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_task_importance_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stitch_badge_warning"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Important"
                    android:textColor="@color/stitch_tertiary_variant"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_task_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stitch_chip_inactive"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/stitch_text_secondary"
                    android:textSize="10sp"
                    tools:text="Technical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Edit/Menu Icon -->
        <ImageView
            android:id="@+id/btn_edit_task"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_stitch_chip_inactive"
            android:contentDescription="Edit"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/stitch_text_secondary" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

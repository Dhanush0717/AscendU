<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="240dp">

        <!-- Top Header & Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_plan_date_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blueprint &amp; Commitments"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Plan"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_action"
                style="@style/Widget.AscendU.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add" />
        </LinearLayout>

        <!-- Quick Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_recurring"
                style="@style/Widget.AscendU.Button.Pill.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="🔁 + Habit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_task"
                style="@style/Widget.AscendU.Button.Pill.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="📅 + One-Time" />
        </LinearLayout>

        <!-- Section 1: Recurring Core Commitments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recurring Core Commitments"
                android:textColor="@color/neu_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_recurring_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_badge_pill"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="0 Active"
                android:textColor="@color/neu_primary_violet_dark"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RecyclerView for Recurring Commitments -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recurring_commitments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_recurring_task" />

        <!-- Empty State for Recurring Commitments -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_recurring_empty"
            style="@style/Widget.AscendU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Recurring Habits Configured"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Add your daily disciplines (study, fitness, coding) to build your consistency arc."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="@dimen/text_body_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: One-Time Tasks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="One-Time Scheduled Tasks"
                android:textColor="@color/neu_text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tasks_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Tasks"
                android:textColor="@color/neu_text_secondary"
                android:textSize="@dimen/text_body_secondary" />
        </LinearLayout>

        <!-- RecyclerView for One-Time Tasks -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_one_time_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_one_time_task" />

        <!-- Empty State for One-Time Tasks -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tasks_empty"
            style="@style/Widget.AscendU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No One-Time Tasks Scheduled"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Schedule specific targets, milestones, assignments or deadlines."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="@dimen/text_body_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

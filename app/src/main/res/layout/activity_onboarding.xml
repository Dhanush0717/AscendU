<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_background">

    <!-- Top App Bar / Progress Indicator -->
    <LinearLayout
        android:id="@+id/layout_onboarding_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_onboarding_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:visibility="invisible"
            app:tint="@color/neu_text_primary" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/indicator_onboarding_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:max="6"
            android:progress="1"
            app:indicatorColor="@color/neu_primary_violet"
            app:trackColor="@color/neu_surface_inset"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tv_onboarding_step_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/6"
            android:textColor="@color/neu_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Screen Content Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_onboarding_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layout_onboarding_bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/layout_onboarding_top">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- SCREEN 1: WELCOME -->
            <LinearLayout
                android:id="@+id/step_1_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Soft Neumorphic Circular Emblem -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="36dp"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/neu_light_highlight"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/neu_surface">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_flame"
                        app:tint="@color/neu_primary_violet" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="AscendU"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Your days. Your discipline. Your transformation."
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="5dp"
                        android:padding="20dp"
                        android:text="Transform fleeting motivation into an engineered daily operating system. Plan recurring core commitments, execute daily milestones, and chart your monthly discipline arc."
                        android:textColor="@color/neu_text_secondary"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SCREEN 2: PERSONALIZATION -->
            <LinearLayout
                android:id="@+id/step_2_personalization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2"
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Personalize Your Journey"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="What should AscendU call you?"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_user_name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundColor="@color/neu_surface"
                    app:boxCornerRadiusBottomEnd="@dimen/neu_corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/neu_corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/neu_corner_small"
                    app:boxCornerRadiusTopStart="@dimen/neu_corner_small"
                    app:boxStrokeColor="@color/neu_primary_violet"
                    app:boxStrokeWidth="1dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your Name or Nickname"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/neu_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Choose Your Primary Focus"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <RadioGroup
                        android:id="@+id/rg_productivity_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rb_academic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingVertical="8dp"
                            android:text="Academic Excellence"
                            android:textColor="@color/neu_text_primary" />

                        <RadioButton
                            android:id="@+id/rb_career"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Career Growth &amp; Tech Mastery"
                            android:textColor="@color/neu_text_primary" />

                        <RadioButton
                            android:id="@+id/rb_fitness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Fitness &amp; Discipline"
                            android:textColor="@color/neu_text_primary" />

                        <RadioButton
                            android:id="@+id/rb_productivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Personal Productivity"
                            android:textColor="@color/neu_text_primary" />

                        <RadioButton
                            android:id="@+id/rb_balanced"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="8dp"
                            android:text="Balanced Lifestyle"
                            android:textColor="@color/neu_text_primary" />
                    </RadioGroup>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SCREEN 3: CORE COMMITMENTS (SELECT / CUSTOMIZE) -->
            <LinearLayout
                android:id="@+id/step_3_commitments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 3"
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose Core Commitments"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Select suggested habits or build custom recurring tasks. (Skippable)"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="14sp" />

                <!-- Checkbox list in elevated card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_habit_exercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Morning Physical Training (45m)"
                            android:textColor="@color/neu_text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_habit_deep_work"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Deep Focus Study Block (60m)"
                            android:textColor="@color/neu_text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_habit_coding"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Coding Practice &amp; Projects (45m)"
                            android:textColor="@color/neu_text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_habit_reading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Reading &amp; Conceptual Learning (30m)"
                            android:textColor="@color/neu_text_primary" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_habit_planning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Daily Review &amp; Plan Tomorrow (15m)"
                            android:textColor="@color/neu_text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Custom Task Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Add A Custom Habit (Optional)"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_custom_habit"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/neu_surface"
                    app:boxCornerRadiusBottomEnd="@dimen/neu_corner_small"
                    app:boxCornerRadiusBottomStart="@dimen/neu_corner_small"
                    app:boxCornerRadiusTopEnd="@dimen/neu_corner_small"
                    app:boxCornerRadiusTopStart="@dimen/neu_corner_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_custom_habit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Meditation or Thesis Writing"
                        android:maxLines="1"
                        android:textColor="@color/neu_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SCREEN 4: SCHEDULE CONFIGURATION -->
            <LinearLayout
                android:id="@+id/step_4_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 4"
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Schedule Configuration"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Configure timing ranges and active repeat days for your commitments."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="14sp" />

                <!-- Timing Block -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prime Focus Time Window"
                            android:textColor="@color/neu_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_pick_start_time"
                                style="@style/Widget.AscendU.Button.Pill.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="Start: 08:00 AM" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_pick_end_time"
                                style="@style/Widget.AscendU.Button.Pill.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="End: 09:30 AM" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Weekday Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Active Repeat Days"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_weekdays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_mon"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Mon" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tue"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tue" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_wed"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Wed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_thu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Thu" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_fri"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Fri" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sat"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sat" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sun"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sun" />
                </com.google.android.material.chip.ChipGroup>

                <!-- High Priority Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_mark_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="true"
                    android:text="Mark selected tasks as High Impact (Important)"
                    android:textColor="@color/neu_text_primary" />
            </LinearLayout>

            <!-- SCREEN 5: ACCOUNTABILITY PREFERENCES -->
            <LinearLayout
                android:id="@+id/step_5_accountability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 5"
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accountability Settings"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Configure nudges to protect your daily streaks and finish what you start."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_important_task_reminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Important-Task Reminders (with 30m Snooze)"
                            android:textColor="@color/neu_text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/neu_outline_subtle" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_evening_closing_reminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Daily Closing Summary Alert"
                            android:textColor="@color/neu_text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_evening_time"
                            style="@style/Widget.AscendU.Button.Pill.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Evening Review: 09:00 PM" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SCREEN 6: COMPLETION & JOURNEY SUMMARY -->
            <LinearLayout
                android:id="@+id/step_6_completion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌟 Ready to Ascend"
                    android:textColor="@color/neu_primary_violet"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_summary_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Welcome, Ascender!"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AscendU.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR SYSTEM SUMMARY"
                            android:textColor="@color/neu_primary_violet_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_summary_commitments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="• 3 Core Commitments Selected"
                            android:textColor="@color/neu_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_summary_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Schedule: Mon - Fri (08:00 - 09:30)"
                            android:textColor="@color/neu_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_summary_accountability"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Daily Closing Review: 09:00 PM"
                            android:textColor="@color/neu_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Discipline is not about motivation. It is about systems. Let's make every day count."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Buttons Bar -->
    <LinearLayout
        android:id="@+id/layout_onboarding_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neu_surface"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_skip"
            style="@style/Widget.AscendU.Button.Pill.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_next"
            style="@style/Widget.AscendU.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="Get Started" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

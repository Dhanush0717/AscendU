<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/stitch_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bottom sheet drag handle pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_stitch_chip_inactive" />

    <TextView
        android:id="@+id/tv_detail_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wednesday, November 11"
        android:textColor="@color/stitch_text_secondary"
        android:textSize="@dimen/text_body_secondary" />

    <TextView
        android:id="@+id/tv_detail_task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Deep Focus Study Block"
        android:textColor="@color/stitch_text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_detail_schedule_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Scheduled: 08:00 AM - 09:30 AM"
        android:textColor="@color/stitch_text_secondary"
        android:textSize="@dimen/text_caption" />

    <!-- Current Occurrence Status Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.AscendU.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/view_detail_status_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_stitch_cell_completed" />

            <TextView
                android:id="@+id/tv_detail_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Status: Completed"
                android:textColor="@color/stitch_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_completed_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="at 08:45"
                android:textColor="@color/stitch_text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Manual History Correction Action Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Manual Record Correction"
        android:textColor="@color/stitch_text_secondary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_completed"
            style="@style/Widget.AscendU.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stitch_secondary"
            android:minHeight="0dp"
            android:text="Done"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_missed"
            style="@style/Widget.AscendU.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stitch_error"
            android:minHeight="0dp"
            android:text="Missed"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_automatic"
            style="@style/Widget.AscendU.Button.Pill.Tonal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Auto"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_detail_close"
        style="@style/Widget.AscendU.Button.Pill.Tonal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Close" />
</LinearLayout>

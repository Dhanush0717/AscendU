<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skill &amp; Capability Matrix"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Demonstrate verified competence across your core pillars."
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_skill_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_skill_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:chipCornerRadius="16dp"
                    android:text="All Skills" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_skill_prog"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="Programming" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_skill_cs"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="Fundamentals" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_skill_dev"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="Development" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_skill_soft"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="Communication" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Skills RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_skills"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_skills"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/primary_purple_light"
                android:padding="12dp"
                android:src="@drawable/ic_nav_skills"
                app:tint="@color/primary_purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No capabilities tracked yet"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add your first target capability to track progression."
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating Action Button: Add Skill -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_skill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="Add Skill"
        app:backgroundTint="@color/primary_purple"
        app:tint="@color/white"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

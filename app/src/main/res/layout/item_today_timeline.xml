<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AscendU.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/stitch_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Checkbox for marking complete -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_timeline_complete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/stitch_primary" />

            <!-- Title & Time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_timeline_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stitch_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Deep Focus Study Block" />

                <TextView
                    android:id="@+id/tv_timeline_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/stitch_text_secondary"
                    android:textSize="@dimen/text_body_secondary"
                    tools:text="08:00 AM - 09:30 AM" />
            </LinearLayout>

            <!-- Status Badge (Done / Active / Upcoming / Missed) -->
            <TextView
                android:id="@+id/tv_timeline_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stitch_badge_neutral"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/stitch_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Active" />
        </LinearLayout>

        <!-- Category & Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_timeline_importance_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stitch_badge_warning"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="High Impact"
                android:textColor="@color/stitch_tertiary_variant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_timeline_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stitch_chip_inactive"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/stitch_text_secondary"
                android:textSize="10sp"
                tools:text="Habit" />

            <TextView
                android:id="@+id/tv_timeline_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stitch_chip_inactive"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/stitch_text_secondary"
                android:textSize="10sp"
                tools:text="Study" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/today_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stitch_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- Top Greeting Header & Settings Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_today_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/stitch_text_secondary"
                        android:textSize="@dimen/text_body"
                        tools:text="Wednesday, November 11" />

                    <!-- Live Synchronized status badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stitch_badge_neutral"
                        android:text="● Synchronized"
                        android:textColor="@color/stitch_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_today_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/stitch_text_primary"
                    android:textSize="@dimen/text_headline_lg"
                    android:textStyle="bold"
                    tools:text="Today 🚀" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_notification_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_stitch_chip_inactive"
                android:contentDescription="Notification Settings"
                android:padding="10dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/stitch_primary" />
        </LinearLayout>

        <!-- Daily Motivational Quote Card (Stitch System) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_quote"
            style="@style/Widget.AscendU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/stitch_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_quote_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stitch_badge_neutral"
                        android:letterSpacing="0.04"
                        android:text="DAILY MOTIVATION"
                        android:textColor="@color/stitch_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/stitch_text_primary"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    tools:text="&quot;You do not rise to the level of your goals. You fall to the level of your systems.&quot;" />

                <TextView
                    android:id="@+id/tv_quote_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/stitch_text_secondary"
                    android:textSize="@dimen/text_body_secondary"
                    android:textStyle="bold"
                    tools:text="— James Clear" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Discipline Progress Card (Stitch System) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AscendU.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/stitch_card_padding">

                <!-- Header & Streak Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Discipline Target"
                        android:textColor="@color/stitch_text_secondary"
                        android:textSize="@dimen/text_body_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_streak_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stitch_badge_warning"
                        android:textColor="@color/stitch_tertiary_variant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="🔥 4 Days Streak" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_progress_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/stitch_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="3 of 5 Core Targets Completed" />

                <!-- Dual-tone Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_today"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="60"
                    android:progressDrawable="@drawable/bg_stitch_progress_bar" />

                <!-- Metric Summary Capsules Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_completed_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_badge_success"
                        android:gravity="center"
                        android:textColor="@color/stitch_secondary_variant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="3 Done" />

                    <TextView
                        android:id="@+id/tv_pending_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_badge_neutral"
                        android:gravity="center"
                        android:textColor="@color/stitch_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="1 Pending" />

                    <TextView
                        android:id="@+id/tv_missed_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stitch_badge_error"
                        android:gravity="center"
                        android:textColor="@color/stitch_error_variant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="1 Missed" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Focus of the Hour / Active Target Section Header -->
        <TextView
            android:id="@+id/tv_current_focus_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Focus of the Hour"
            android:textColor="@color/stitch_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Focus of the Hour Hero Card with Left Accent Strip -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_current_focus"
            style="@style/Widget.AscendU.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stitch_card_hero"
                android:orientation="vertical"
                android:padding="@dimen/stitch_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● IN PROGRESS"
                        android:textColor="@color/stitch_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stitch_badge_warning"
                        android:text="High Impact"
                        android:textColor="@color/stitch_tertiary_variant"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_task_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/stitch_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Deep Focus Study Block" />

                <TextView
                    android:id="@+id/tv_current_task_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/stitch_text_secondary"
                    android:textSize="@dimen/text_body_secondary"
                    tools:text="08:00 AM - 09:30 AM • Study" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_complete_current"
                    style="@style/Widget.AscendU.Button.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:minHeight="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Done"
                    android:textSize="@dimen/text_body_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chronological Daily Timeline Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Today's Timeline"
            android:textColor="@color/stitch_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Timeline RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_today_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_today_timeline" />

        <!-- Clean Empty State Container -->
        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_stitch_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Clear Horizon"
                android:textColor="@color/stitch_text_primary"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="No commitments scheduled for today.\nHead over to Plan to architect your daily routine."
                android:textColor="@color/stitch_text_secondary"
                android:textSize="@dimen/text_body_secondary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

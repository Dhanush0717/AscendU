<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stitch_cell_missed_bg" />
            <corners android:radius="@dimen/stitch_corner_cell" />
            <stroke
                android:width="1dp"
                android:color="@color/stitch_cell_missed" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="8dp"
        android:height="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/stitch_cell_missed" />
        </shape>
    </item>
</layer-list>

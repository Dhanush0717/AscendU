<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/stitch_surface_subtle" />
            <corners android:radius="@dimen/stitch_corner_input" />
            <stroke
                android:width="@dimen/stitch_stroke_active"
                android:color="@color/stitch_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stitch_surface_subtle" />
            <corners android:radius="@dimen/stitch_corner_input" />
            <stroke
                android:width="@dimen/stitch_stroke_subtle"
                android:color="@color/stitch_outline_subtle" />
        </shape>
    </item>
</selector>

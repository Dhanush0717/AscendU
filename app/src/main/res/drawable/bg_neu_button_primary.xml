<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: slightly darker inset feel -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_primary_violet_dark" />
            <corners android:radius="@dimen/neu_corner_pill" />
        </shape>
    </item>
    <!-- Default state: soft primary violet -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_primary_violet" />
            <corners android:radius="@dimen/neu_corner_pill" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_light_highlight" />
        </shape>
    </item>
</selector>

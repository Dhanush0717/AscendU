    <!-- STITCH SYSTEM DESIGN TOKENS (LIGHT THEME)               -->
    <!-- Project: AscendU Redesign System (5617786173306949825)   -->
    <!-- ======================================================== -->

    <!-- Primary Accent: Deep Indigo Violet -->
    <color name="stitch_primary">#4F46E5</color>
    <color name="stitch_primary_variant">#3525CD</color>
    <color name="stitch_primary_dark">#4338CA</color>
    <color name="stitch_primary_tint">#EDE9FE</color>
    <color name="stitch_primary_tint_light">#F5F3FF</color>
    <color name="stitch_on_primary">#FFFFFF</color>

    <!-- Secondary Accent: Emerald Green (Completion / Positive Reinforcement) -->
    <color name="stitch_secondary">#10B981</color>
    <color name="stitch_secondary_variant">#006C49</color>
    <color name="stitch_secondary_tint">#ECFDF5</color>
    <color name="stitch_on_secondary">#FFFFFF</color>


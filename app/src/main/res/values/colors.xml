    <color name="neu_surface">#F2EFF9</color>
    <color name="neu_surface_inset">#DFDCE8</color>
    
    <!-- Highlights & Subtle Soft Shadows -->
    <color name="neu_light_highlight">#FFFFFFFF</color>

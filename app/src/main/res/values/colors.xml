    <!-- Canvas background: Soft breathable off-white with micro-tinted lavender atmosphere -->
    <color name="stitch_background">#FCF8FF</color>
    <!-- Surface Card: Elevated pure white sheet -->
    <color name="stitch_surface">#FFFFFF</color>
    <!-- Surface Container / Subtle: Tonal lavender surface for inputs, tags, and table headers -->
    <color name="stitch_surface_subtle">#F6F2FF</color>
    <color name="stitch_surface_container">#EFEBFF</color>
    <color name="stitch_surface_container_high">#E9E5FF</color>


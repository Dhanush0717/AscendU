    <color name="stitch_text_primary">#181445</color>
    <color name="stitch_text_secondary">#464555</color>
    <color name="stitch_text_tertiary">#777587</color>
    <color name="stitch_text_muted">#9CA3AF</color>

    <!-- Consistency Matrix Cell States (Stitch Specification) -->
    <color name="stitch_cell_completed">#10B981</color>

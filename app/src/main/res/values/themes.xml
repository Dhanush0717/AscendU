<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme: Material 3 + AscendU Stitch Design System (Light) -->
    <style name="Base.Theme.AscendU" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/stitch_primary</item>
        <item name="colorOnPrimary">@color/stitch_on_primary</item>
        <item name="colorPrimaryContainer">@color/stitch_primary_tint</item>
        <item name="colorOnPrimaryContainer">@color/stitch_primary_variant</item>

        <item name="colorSecondary">@color/stitch_secondary</item>
        <item name="colorOnSecondary">@color/stitch_on_secondary</item>
        <item name="colorSecondaryContainer">@color/stitch_secondary_tint</item>

        <item name="colorTertiary">@color/stitch_tertiary</item>
        <item name="colorOnTertiary">@color/stitch_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/stitch_tertiary_tint</item>

        <item name="colorError">@color/stitch_error</item>
        <item name="colorOnError">@color/stitch_on_error</item>
        <item name="colorErrorContainer">@color/stitch_error_tint</item>

        <!-- Surfaces and Backgrounds (Stitch Soft Lavender-Tinted Canvas) -->
        <item name="android:windowBackground">@color/stitch_background</item>
        <item name="colorSurface">@color/stitch_surface</item>
        <item name="colorOnSurface">@color/stitch_text_primary</item>
        <item name="colorSurfaceVariant">@color/stitch_surface_subtle</item>
        <item name="colorOnSurfaceVariant">@color/stitch_text_secondary</item>
        <item name="colorOutline">@color/stitch_outline_subtle</item>

        <!-- Status Bar & Navigation Bar (Edge to Edge, Clean) -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Typography Font Family -->
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Theme.AscendU" parent="Base.Theme.AscendU" />

    <!-- Stitch Elevated Standard Card Style (16dp Radius, 1dp subtle border) -->
    <style name="Widget.AscendU.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/stitch_corner_card</item>
        <item name="cardElevation">@dimen/stitch_elevation_card</item>
        <item name="strokeWidth">@dimen/stitch_stroke_subtle</item>
        <item name="strokeColor">@color/stitch_outline_subtle</item>
        <item name="cardBackgroundColor">@color/stitch_surface</item>
    </style>

    <!-- Stitch Hero / Highlight Card (20dp Radius) -->
    <style name="Widget.AscendU.Card.Hero" parent="Widget.AscendU.Card">
        <item name="cardCornerRadius">@dimen/stitch_corner_hero</item>
        <item name="cardElevation">@dimen/stitch_elevation_hero</item>
        <item name="strokeWidth">@dimen/stitch_stroke_subtle</item>
        <item name="strokeColor">@color/stitch_outline_subtle</item>
        <item name="cardBackgroundColor">@color/stitch_surface</item>
    </style>

    <!-- Stitch Primary Pill Action Button (Height 48dp, Solid #4F46E5) -->
    <style name="Widget.AscendU.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/stitch_corner_pill</item>
        <item name="elevation">2dp</item>
        <item name="backgroundTint">@color/stitch_primary</item>
        <item name="android:textColor">@color/stitch_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Stitch Secondary / Tonal Pill Button (Subtle Lavender Fill) -->
    <style name="Widget.AscendU.Button.Pill.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/stitch_corner_pill</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/stitch_primary_tint</item>
        <item name="android:textColor">@color/stitch_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="strokeWidth">@dimen/stitch_stroke_subtle</item>
        <item name="strokeColor">@color/stitch_outline_subtle</item>
    </style>

    <!-- Bottom Navigation Bar Indicator Pill -->
    <style name="Widget.AscendU.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/stitch_primary_tint</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>
</resources>

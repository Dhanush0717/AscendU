<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme: Modern Soft Neumorphism + Minimalist Productivity UI (Light) -->
    <style name="Base.Theme.AscendU" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/neu_primary_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/neu_accent_tint</item>
        <item name="colorOnPrimaryContainer">@color/neu_primary_violet_dark</item>

        <item name="colorSecondary">@color/neu_secondary_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/neu_surface_inset</item>

        <!-- Surfaces and Backgrounds (Soft Lavender-Grey Canvas) -->
        <item name="android:windowBackground">@color/neu_background</item>
        <item name="colorSurface">@color/neu_surface</item>
        <item name="colorOnSurface">@color/neu_text_primary</item>
        <item name="colorSurfaceVariant">@color/neu_accent_tint</item>
        <item name="colorOnSurfaceVariant">@color/neu_text_secondary</item>
        <item name="colorOutline">@color/neu_outline_subtle</item>

        <!-- Status Bar & Navigation Bar (Edge to Edge, Clean) -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AscendU" parent="Base.Theme.AscendU" />

    <!-- Neumorphic Elevated Card Styles -->
    <style name="Widget.AscendU.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/neu_corner_card</item>
        <item name="cardElevation">@dimen/neu_elevation_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/neu_light_highlight</item>
        <item name="cardBackgroundColor">@color/neu_surface</item>
    </style>

    <!-- Neumorphic Hero / Highlight Card -->
    <style name="Widget.AscendU.Card.Hero" parent="Widget.AscendU.Card">
        <item name="cardCornerRadius">@dimen/neu_corner_hero</item>
        <item name="cardElevation">@dimen/neu_elevation_hero</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/neu_light_highlight</item>
        <item name="cardBackgroundColor">@color/neu_accent_tint</item>
    </style>

    <!-- Neumorphic Primary Pill Button -->
    <style name="Widget.AscendU.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/neu_corner_pill</item>
        <item name="elevation">3dp</item>
        <item name="backgroundTint">@color/neu_primary_violet</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Neumorphic Tonal / Soft Elevated Pill Button -->
    <style name="Widget.AscendU.Button.Pill.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/neu_corner_pill</item>
        <item name="elevation">2dp</item>
        <item name="backgroundTint">@color/neu_surface</item>
        <item name="android:textColor">@color/neu_primary_violet_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/neu_light_highlight</item>
    </style>

    <!-- Active Indicator for Floating Nav Dock -->
    <style name="Widget.AscendU.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/neu_accent_tint</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
    </style>
</resources>
